"""State Electricity Subsidy Eligibility (separate if vs if-elif-else)"""

def subsidy_many(units, ration_card, member_above_80):
	"""Several separate if statements - a household can receive TWO subsidies."""
	result = []
	if units <= 100:
		result.append("FULL")
	if 101 <= units <= 200 and ration_card:
		result.append("PARTIAL")
	if units <= 200 and ration_card:  # developer's overlapping condition
		result.append("PARTIAL")
	if units > 200 and member_above_80:
		result.append("SENIOR")
	return result or ["NONE"]

def subsidy_elif(units, ration_card, member_above_80):
	"""if-elif-else = exactly one decision is possible."""
	if units <= 100:
		return "FULL"
	elif 101 <= units <= 200 and ration_card:
		return "PARTIAL"
	elif units > 200 and member_above_80:
		return "SENIOR"
	else:
		return "NONE"

households = [
	# (units, ration_card, member_above_80)
	(100, False, False), (100, True, False),
	(200, True, False), (200, False, False),
	(201, True, False), (201, False, True),
]

print(f"{'units':>5} {'ration':>7} {'80+':>5} | {'separate if':<15} | if-elif-else")
for u, r, a in households:
	print(f"{u:>5} {str(r):>7} {str(a):>5} | {','.join(subsidy_many(u, r, a)):15} | {subsidy_elif(u, r, a)}")
